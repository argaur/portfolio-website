{
  "redirects": [
    { "source": "/case-study-founder-crm.html", "destination": "/case-study-siteline.html#origin", "permanent": true },
    { "source": "/case-study-founder-crm", "destination": "/case-study-siteline.html#origin", "permanent": true },
    { "source": "/assets/gaurav-gupta-resume-2026.pdf", "destination": "/GauravGupta_Resume_2026.pdf", "permanent": true },
    { "source": "/photo.jpg", "destination": "/assets/og.jpg", "permanent": true },
    { "source": "/builds", "destination": "/builds.html", "permanent": true },
    { "source": "/builds/", "destination": "/builds.html", "permanent": true },
    { "source": "/hackathons", "destination": "/hackathons.html", "permanent": true },
    { "source": "/hackathons/", "destination": "/hackathons.html", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" },
        { "key": "Content-Security-Policy-Report-Only", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.tailwindcss.com https://us-assets.i.posthog.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://us.i.posthog.com https://us-assets.i.posthog.com; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com https://player.vimeo.com https://www.loom.com https://drive.google.com; media-src 'self'; object-src 'none'; base-uri 'self'" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }]
    },
    {
      "source": "/(.*)\\.(css|js|svg)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }]
    }
  ]
}
